# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，禁止提交真实密钥。
MAUTO_ENV=production
MAUTO_BASE_URL=https://mauto.com

# 局域网调试：MAUTO_LAN=1 时监听 0.0.0.0，并默认使用 HTTP 地址与非 Secure Cookie
MAUTO_LAN=0

# 反向代理与域名
MAUTO_ALLOWED_HOSTS=mauto.com,www.mauto.com
MAUTO_CORS_ORIGINS=https://mauto.com,https://www.mauto.com
MAUTO_COOKIE_SECURE=true
MAUTO_COOKIE_SAMESITE=lax
MAUTO_COOKIE_DOMAIN=

# 进程与缓存
MAUTO_WORKERS=2
MAUTO_STATIC_CACHE_SECONDS=86400
MAUTO_LOG_LEVEL=info

# 反向代理来源（Nginx/Caddy 与容器同机时保持 127.0.0.1；如需信任全部可设为 *）
MAUTO_FORWARDED_ALLOW_IPS=127.0.0.1

# 可选：真实模型（不填则使用内置演示引擎）
MAUTO_LLM_API_KEY=
MAUTO_LLM_BASE_URL=https://api.openai.com/v1
MAUTO_LLM_MODEL=gpt-4o-mini

# 可选：联网检索与资讯刷新
MAUTO_SEARCH_ENGINE=auto
MAUTO_SEARCH_MAX_RESULTS=5
MAUTO_NEWS_REFRESH_MINUTES=30
